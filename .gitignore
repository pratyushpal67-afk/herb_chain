# ============================================
# AYURTRACE Frontend - .gitignore
# ============================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
android/app/debug
android/app/profile
android/app/release

# Widget Preview related
.widget_preview/

# ============================================
# SECURITY - Never commit these!
# ============================================

# Environment files
.env
.env.*
.env.local
.env.production
.env.development
.env.test

# Keys & Certificates
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
*.jks
keystore.properties
key.properties
android/key.properties
android/app/key.properties

# Firebase/Google Services
google-services.json
GoogleService-Info.plist
firebase_options.dart

# Flutter secure storage (may contain tokens)
.flutter-plugins-dependencies

# Build artifacts with potential secrets
/build/
/coverage/

# Local properties (may contain SDK paths, passwords)
local.properties
android/local.properties
ios/Flutter/Generated.xcconfig

# Dart/Flutter packages cache
.pub-cache/
.pub/

# Generated files that may contain sensitive data
lib/generated/
*.g.dart
*.freezed.dart
*.config.dart

# Android signing configs
android/app/src/main/res/raw/keystore.properties

# iOS provisioning profiles
*.mobileprovision
*.entitlements

# Web build
web/build/
web/*.js
web/*.map
web/*.wasm

# Test outputs
test_driver/
integration_test/
*.test.dart.snapshot

# OS
.DS_Store
Thumbs.db